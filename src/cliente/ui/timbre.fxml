<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="cliente.ui.Controller">
    <children>
        <VBox spacing="10" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="10">
            <children>
                <Label text="Aplicación: Servicio hora de entrada" />
                <GridPane hgap="10" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="25" />
                        <ColumnConstraints percentWidth="75" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints />
                    </rowConstraints>
                    <children>
                        <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                        <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                    </children>
                </GridPane>

                <HBox spacing="10">
                    <children>
                        <Button text="Timbre" fx:id="timbreButton" onAction="#onTimbre" />
                        <Label fx:id="statusLabel" text="" />
                    </children>
                </HBox>

                <Label text="Registros:" />
                <ListView fx:id="listView" prefHeight="200" />
            </children>
            <padding>
                <Insets top="10" right="10" bottom="10" left="10" />
            </padding>
        </VBox>
    </children>
</AnchorPane>

